# Copy to `.env` for local use. `.env` is gitignored — never commit it.
# In GitHub Actions these are repository secrets instead, with identical names.
#
# .env never overrides a real environment variable, so an exported value wins.

# --- state encryption -------------------------------------------------------
# From `coursetrack init-key`. Also stored in your macOS Keychain, so locally
# you can usually leave this unset.
COURSETRACK_KEY=

# --- Canvas (read-only) -----------------------------------------------------
# Account -> Settings -> "+ New Access Token" on your Canvas instance.
CANVAS_TOKEN=

# --- Google Calendar --------------------------------------------------------
# A service account key, base64-encoded onto one line:
#   base64 -i ~/Downloads/<project>-<hash>.json | tr -d '\n'
#
# A service account needs no OAuth consent screen, no app verification, and
# has no token that expires. It can only reach calendars explicitly shared
# with its email address — run `coursetrack google-check` to print that email.
GOOGLE_SERVICE_ACCOUNT_JSON=

# The ID of the one calendar you shared with the service account. Find it in
# Google Calendar under Settings and sharing -> Integrate calendar.
# Looks like: abc123...@group.calendar.google.com
GOOGLE_CALENDAR_ID=

# --- Email ------------------------------------------------------------------
# The Gmail account that sends the reminders, and a 16-character app password
# from https://myaccount.google.com/apppasswords (requires 2-Step Verification).
# This is NOT your Google account password.
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Hosted dashboard -------------------------------------------------------
# Unlocks docs/data.enc in the browser. The ciphertext is published publicly,
# so this must be strong. Generated by setup; read it back with:
#   security find-generic-password -s coursetrack -a dashboard-passphrase -w
DASHBOARD_PASSPHRASE=
